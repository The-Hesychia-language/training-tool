# So far the compiler has worked out types and borrowing for you: that is the
# `managed` level. In `manual` you write them, and get to say exactly what
# happens. A variable is declared with its type, `mut` if it changes and `const`
# if it does not; a parameter says how it takes its value: `&` lends it for
# reading.
#
# FIX: write the declaration `manual` asks for.

manual fn largest(values: &vector[i64]) -> i64:
    best = values[0]
    for i in range(len(values)):
        if values[i] > best:
            best = values[i]
    return best
